---
import DefaultPageFrame from '@astrojs/starlight/components/PageFrame.astro';
import SiteFooter from './SiteFooter.astro';
---
<div class="site-frame">
	<DefaultPageFrame>
		<slot name="header" slot="header" />
		<slot name="sidebar" slot="sidebar" />
		<slot />
	</DefaultPageFrame>
	<SiteFooter />
</div>

<style>
	@media screen {
		.site-frame {
			--sl-main-pad: 0;
			display: flex;
			flex-direction: column;
			min-block-size: 100vh;
		}

		.site-frame > :global(.page) {
			flex: 1;
			min-block-size: 0;
		}
	}
</style>
