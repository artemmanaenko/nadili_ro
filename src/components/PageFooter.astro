---
import DefaultFooter from '@astrojs/starlight/components/Footer.astro';
import EditLink from '@astrojs/starlight/components/EditLink.astro';
import LastUpdated from '@astrojs/starlight/components/LastUpdated.astro';
import GuideCredits from './GuideCredits.astro';

const { editUrl, entry, lastUpdated } = Astro.locals.starlightRoute;
const { collectedOn } = entry.data;
---
{collectedOn ? (
	<footer class="guide-meta">
		<p>Зібрано <time datetime={collectedOn}>{collectedOn}</time>.</p>
		<EditLink />
		<LastUpdated />
	</footer>
) : (editUrl || lastUpdated) && <DefaultFooter />}
<GuideCredits placement="footer" />

<style>
	.guide-meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.25rem 1rem;
		margin-block-start: 0.75rem;
		color: var(--sl-color-gray-3);
		font-size: var(--sl-text-sm);
	}

	.guide-meta :global(a) {
		min-block-size: 24px;
		text-decoration: underline;
		text-underline-offset: 0.15em;
	}
</style>
