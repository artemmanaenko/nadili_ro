---
// Guide summary card shown before "Кроки": key facts as tiles, an optional
// highlighted note (the slot "highlight"), and short footnotes (default slot).
interface Props {
	/** Pairs of [label, value], e.g. [["Термін", "2-3 місяці"]]. */
	facts: [string, string][];
}

const { facts } = Astro.props;
const hasHighlight = Astro.slots.has('highlight');
const hasNotes = Astro.slots.has('default');
---

<section class="summary not-content" aria-label="Коротко">
	<dl class="facts">
		{
			facts.map(([label, value]) => (
				<div class="fact">
					<dt>{label}</dt>
					<dd>{value}</dd>
				</div>
			))
		}
	</dl>
	{
		hasHighlight && (
			<div class="highlight">
				<svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
					<rect x="3" y="5" width="18" height="14" rx="2" />
					<circle cx="9" cy="12" r="2.25" />
					<path d="M14 10h4M14 14h4" />
				</svg>
				<div><slot name="highlight" /></div>
			</div>
		)
	}
	{
		hasNotes && (
			<div class="notes">
				<slot />
			</div>
		)
	}
</section>

<style>
	.summary {
		display: grid;
		gap: 0.65rem;
		margin-block: 0 1.25rem;
		padding: 0.9rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 14px;
		background: var(--sl-color-gray-7);
	}
	.facts {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
		gap: 0.75rem;
		margin: 0;
	}
	.fact {
		padding: 0.6rem 0.85rem;
		border: 1px solid var(--sl-color-gray-6);
		border-radius: 10px;
		background: var(--sl-color-black);
	}
	dt {
		color: var(--sl-color-gray-3);
		font-size: var(--sl-text-xs);
		font-weight: 600;
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}
	dd {
		margin: 0.15rem 0 0;
		color: var(--sl-color-white);
		font-size: var(--sl-text-lg);
		font-weight: 600;
		line-height: 1.3;
	}
	.highlight {
		display: flex;
		gap: 0.75rem;
		align-items: flex-start;
		padding: 0.65rem 0.85rem;
		border-radius: 10px;
		background: var(--sl-color-accent-low);
		color: var(--sl-color-white);
		line-height: 1.5;
	}
	.highlight svg {
		flex: none;
		margin-top: 0.1rem;
		color: var(--sl-color-accent);
	}
	.highlight :global(p) {
		margin: 0;
	}
	.notes {
		color: var(--sl-color-gray-3);
		font-size: var(--sl-text-sm);
		line-height: 1.5;
	}
	.notes :global(p) {
		margin: 0;
	}
	.notes :global(p + p) {
		margin-top: 0.35rem;
	}
	.notes :global(a) {
		color: var(--sl-color-gray-2);
	}
	@media print {
		.summary {
			break-inside: avoid;
		}
	}
</style>
