---
import DefaultHead from '@astrojs/starlight/components/Head.astro';
import { getImage } from 'astro:assets';

const { socialImage } = Astro.locals.starlightRoute.entry.data;
const card = socialImage && await getImage({ src: socialImage.src, format: 'jpeg' });
const cardUrl = card && new URL(card.src, Astro.site ?? Astro.url).href;
---

<DefaultHead />
{card && socialImage && (
	<>
		<meta property="og:image" content={cardUrl} />
		<meta property="og:image:type" content="image/jpeg" />
		<meta property="og:image:width" content={String(card.attributes.width)} />
		<meta property="og:image:height" content={String(card.attributes.height)} />
		<meta property="og:image:alt" content={socialImage.alt} />
		<meta name="twitter:image" content={cardUrl} />
		<meta name="twitter:image:alt" content={socialImage.alt} />
	</>
)}

<script>
	function openExternalLinksInNewTab() {
		for (const link of document.querySelectorAll('a[href]')) {
			if (!(link instanceof HTMLAnchorElement)) continue;
			if (!['http:', 'https:'].includes(link.protocol) || link.origin === location.origin) continue;
			link.target = '_blank';
			link.relList.add('noopener', 'noreferrer');
		}
	}

	const headingLinkSelector = '.sl-heading-wrapper > a.sl-anchor-link';
	const copyLabel = 'Скопіювати посилання';
	const copyStatus = document.createElement('div');
	copyStatus.className = 'heading-link-status';
	copyStatus.setAttribute('role', 'status');
	let statusTimer: number;

	function labelHeadingLinks() {
		document.querySelectorAll<HTMLAnchorElement>(headingLinkSelector).forEach((link) => {
			const heading = link.previousElementSibling?.textContent?.trim();
			link.title = copyLabel;
			link.setAttribute('aria-label', heading ? `${copyLabel}: ${heading}` : copyLabel);
		});
		document.body.append(copyStatus);
	}

	document.addEventListener('click', async (event) => {
		if (event.defaultPrevented || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
		if (!(event.target instanceof Element)) return;
		const link = event.target.closest<HTMLAnchorElement>(headingLinkSelector);
		if (!link) return;

		event.preventDefault();
		try {
			await navigator.clipboard.writeText(link.href);
			copyStatus.textContent = 'Посилання скопійовано';
			window.clearTimeout(statusTimer);
			statusTimer = window.setTimeout(() => { copyStatus.textContent = ''; }, 2500);
		} catch {
			window.prompt('Скопіюйте посилання', link.href);
		}
	});

	document.addEventListener('astro:page-load', openExternalLinksInNewTab);
	document.addEventListener('astro:page-load', labelHeadingLinks);
	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', openExternalLinksInNewTab);
		document.addEventListener('DOMContentLoaded', labelHeadingLinks);
	} else {
		openExternalLinksInNewTab();
		labelHeadingLinks();
	}
</script>

<style is:global>
	.heading-link-status:not(:empty) {
		position: fixed;
		z-index: var(--sl-z-index-navbar);
		inset-block-end: 1rem;
		inset-inline-end: 1rem;
		padding: 0.4rem 0.75rem;
		border-radius: 6px;
		background: var(--sl-color-white);
		color: var(--sl-color-black);
		font-size: var(--sl-text-sm);
		pointer-events: none;
	}
	@media print {
		.heading-link-status { display: none; }
	}
</style>
